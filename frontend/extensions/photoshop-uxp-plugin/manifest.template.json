{
  "id": "com.pixelreorg.canvas.photoshop",
  "name": "画布 Photoshop 插件",
  "version": "0.1.21",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0"
    }
  ],
  "manifestVersion": 5,
  "entrypoints": [
    {
      "type": "panel",
      "id": "canvas-photoshop-panel",
      "label": {
        "default": "画布 Photoshop 插件"
      },
      "minimumSize": {
        "width": 240,
        "height": 300
      },
      "maximumSize": {
        "width": 1200,
        "height": 1200
      },
      "preferredDockedSize": {
        "width": 350,
        "height": 600
      },
      "preferredFloatingSize": {
        "width": 450,
        "height": 800
      }
    },
    {
      "type": "command",
      "id": "save-to-canvas-library",
      "label": {
        "default": "保存图层到素材库"
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess"
  }
}
