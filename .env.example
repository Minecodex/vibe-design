# =============================================================================
# ai-code 环境变量示例
# 资源规格：8 核 / 16 线程，32GB 内存，16GB 显存 GPU
#
# 运行 docker compose 前，请先将此文件复制为 .env。
# 不要提交真实密钥、API Key、云凭证、Cookie 或 Token。
# =============================================================================

# =============================================================================
# 应用标识与运行环境
# =============================================================================
# 当前应用环境。支持值：development、staging、production。
APP_ENV=development
# 是否开启后端详细调试日志。共享环境或生产环境应保持 false。
DEBUG=false
# 应用中文名称，用于界面展示和运行时配置。
APP_NAME=像素重组
# 应用英文名称，用于英文界面和运行时配置。
APP_NAME_EN=Pixel Reorganization

# =============================================================================
# 前端访问后端
# =============================================================================
# Web 前端访问后端的公开地址；前端会自动规范化 /api/v1。
APP_API_BASE_URL=http://localhost:8000

# =============================================================================
# 认证、CORS 与安全
# =============================================================================
# JWT 签名密钥。非本地部署前必须替换为足够长的随机字符串。
SECRET_KEY=change-me-to-a-long-random-string-in-production
# Access Token 有效期，单位分钟。
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh Token 有效期，单位天。
REFRESH_TOKEN_EXPIRE_DAYS=7
# CORS 允许的浏览器来源，多个值用英文逗号分隔。
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# 旧许可证校验兼容项；当前运行流程不使用。换行请使用 \n。
REDEMPTION_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAkhJ0DMrt+tcl/Zf+lO3b\naFNaC2muCGAwsEI7T7hM1T9B+qyzDRYMfhnDDJ0AC3vy7hIr2u+a0qf8jvnA7L2s\n93xEr7BQ+0zaceWvoScEg/Mp/3XAhLWBqMC4Hk6ijEVWZibKe7vNgBuUFjrqG44A\nyv0iPmdB0y4CAWugQoV2quaTYLy6lWmTO1BIEB+dGE1EBwKrVBEYkjAiRgMGbbSw\npKCCQWlpYgrKWaNWFNvO6VWWC1On60nc1yYxt//yQ2BZJ318OR5ar/2V9ZCxTI1F\nCv2143Sx66J2rqkXrgq4kbOKOlh6VAwsyYvQuDKsIz0YyEWi1Nz+8cVVZ8ULOiNS\nBwIDAQAB\n-----END PUBLIC KEY-----\n

# =============================================================================
# 数据库（compose 内部用三件套拼出 DATABASE_URL）
# =============================================================================
# 应用连接 MySQL 使用的用户名。
MYSQL_USER=appuser
# 应用连接 MySQL 使用的密码；共享环境或生产环境部署前必须替换。
MYSQL_PASSWORD=apppassword
# 应用使用的 MySQL 数据库名。
MYSQL_DATABASE=appdb
# MySQL root 密码，用于 compose 初始化和健康检查。
MYSQL_ROOT_PASSWORD=rootpassword

# =============================================================================
# 数据库连接池（仅与 worker 数和总连接预算相关；其余 SQLAlchemy 调优项已硬编码）
# 8 核 / 16 线程配置：6 个 worker *（10 个基础连接 + 10 个溢出连接）= 后端最多 120 个数据库连接。
# =============================================================================
# 每个后端 worker 进程保留的常驻数据库连接数。
DB_POOL_SIZE=10
# 每个后端 worker 进程允许临时创建的溢出数据库连接数。
DB_MAX_OVERFLOW=10

# =============================================================================
# Redis 协调层
# Redis 用于短生命周期协调、唤醒、去重、发布订阅和所有权登记。
# 业务事实仍以数据库状态为准。
# =============================================================================
# 是否启用基于 Redis 的协调路径。
REDIS_ENABLED=true
# Redis 不可用时，是否让启动或关键协调流程失败。
REDIS_REQUIRED=true
# Redis 连接地址。
REDIS_URL=redis://redis:6379/0
# Redis 客户端连接池最大连接数；与 WEB_CONCURRENCY 线性相关。6 worker 配置下 32 足够。
REDIS_MAX_CONNECTIONS=32

# =============================================================================
# 会话事件通知合并（Notification Coalescing）
# =============================================================================
# 是否启用事件通知合并。
EVENT_NOTIFICATION_COALESCE_ENABLED=true
# 合并窗口大小，单位毫秒；窗口越大合并率越高，但首字延迟也越大。
EVENT_NOTIFICATION_COALESCE_WINDOW_MS=100

# =============================================================================
# 后端进程与业务级超时
# =============================================================================
# Uvicorn/FastAPI worker 进程数；由于每个 worker 都可能访问 GPU 服务，应保持保守。
WEB_CONCURRENCY=6
# 图片生成任务超时时间，单位秒。
TASK_TIMEOUT_IMAGE_SECONDS=1800
# 视频生成任务超时时间，单位秒。
TASK_TIMEOUT_VIDEO_SECONDS=18000

# =============================================================================
# Agent Harness 存储、审计与沙箱
# =============================================================================
# Harness workspace 和会话文件的根目录。
HARNESS_WORKSPACE_ROOT=uploads/harness
# 头像上传最大文件大小，单位字节。默认 5MB。
AVATAR_UPLOAD_MAX_BYTES=5242880
# Canvas 图片上传最大文件大小，单位字节。默认 40MB。
CANVAS_IMAGE_UPLOAD_MAX_BYTES=41943040
# Canvas 视频上传最大文件大小，单位字节。默认 1GB。
CANVAS_VIDEO_UPLOAD_MAX_BYTES=1048576000
# Harness 附件上传最大文件大小，单位字节。默认 50MB。
HARNESS_ATTACHMENT_UPLOAD_MAX_BYTES=52428800
# 本地图片转 base64 时触发压缩的文件大小阈值，单位字节。
BASE64_IMAGE_COMPRESS_THRESHOLD_BYTES=20971520
# 本地图片 base64 压缩质量，1-100。
BASE64_IMAGE_QUALITY=82
# 本地图片压缩后允许进入 base64 的最大源字节数，单位字节。超过直接报错。
BASE64_IMAGE_OUTPUT_MAX_BYTES=20971520
# 远程媒体流式下载最大大小，单位字节；data URI 解码后字节数也共用此上限。
MEDIA_DOWNLOAD_MAX_BYTES=2097152000
# 远程媒体流式下载单次 HTTP 超时时间，单位秒。
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=180
# Office session 打开源文件最大大小，单位字节。超过不会读入内存。
OFFICE_SESSION_MAX_SOURCE_BYTES=104857600
# Office session 缓存有效期，单位秒。
OFFICE_SESSION_TTL_SECONDS=86400

# =============================================================================
# 对象存储（TOS/OSS）
# =============================================================================
# 图片生成本地参考图会先上传到对象存储，再以远程 URL 提交给生成模型。
# [必填] 部署前必须填写 TOS Access Key，不要提交真实凭证。
TOS_AK=
# [必填] 部署前必须填写 TOS Secret Key，不要提交真实凭证。
TOS_SK=
TOS_ENDPOINT=tos-cn-guangzhou.volces.com
TOS_REGION=cn-guangzhou
TOS_BUCKET_NAME=design-public
# 自定义公网访问前缀；留空时使用 https://{TOS_BUCKET_NAME}.{TOS_ENDPOINT}/{object_key}
TOS_PUBLIC_BASE_URL=
# 图片生成参考图上传的对象 key 前缀。
TOS_OBJECT_PREFIX=generation-refs/

# Harness 命令执行沙箱（bubblewrap）。命令执行前用 bwrap 包一层 OS 级隔离；
# 当前运行时不支持 bwrap（缺少 bubblewrap、非 Linux 开发机等）时自动降级为直接执行。
# 置为 false 可强制关闭沙箱、始终直接执行（便于排障）。
HARNESS_SANDBOX_ENABLED=true
# 沙箱可用时，对“无法静态证明安全但非危险”的命令（如 $ 变量展开、命令替换）自动放行，
# 交由 OS 沙箱兜底（对标 claude-code 的 autoAllowBashIfSandboxed）；置为 false 则这类命令一律拒绝。
HARNESS_SANDBOX_AUTO_ALLOW=true

# =============================================================================
# Agent Harness 用户可见的总时长上限、上下文压缩与 recall sidecar worker
# =============================================================================
# 单轮模型调用的最长持续时间，单位秒。
HARNESS_MODEL_TURN_TIMEOUT_SECONDS=500
# 主页消息侧路由分类器（side classifier）的最长等待时间，单位秒。
CLASSIFIER_TIMEOUT_SECONDS=120
# 模型流读取超时时间，单位秒。
HARNESS_STREAM_READ_TIMEOUT_SECONDS=720
# 是否启用 Home Harness Design Jury 效果质量检查；默认开启。仅 home 下 web/html 和 html-ppt 生效。
HARNESS_CRITIQUE_ENABLED=True
# Design Jury 最多自动修订轮数；达到上限仍未达标时按 fallback 策略发布或失败。
HARNESS_CRITIQUE_MAX_ROUNDS=3
# Design Jury 评分满分，panelist 分数和维度分数都按此量表校验。
HARNESS_CRITIQUE_SCORE_SCALE=10
# Design Jury 通过阈值；后端按固定权重重算 composite，达到阈值且无 MUST_FIX 才授权发布。
HARNESS_CRITIQUE_SCORE_THRESHOLD=8.0
# 未达标或超时时的兜底策略：ship_best 发布最高分轮次，ship_last 发布最后轮次，fail 则拒绝发布。
HARNESS_CRITIQUE_FALLBACK_POLICY=ship_best
# 单轮 Design Jury 修订/评分超时时间，单位秒；超时后会尝试恢复当前最佳快照。
HARNESS_CRITIQUE_PER_ROUND_TIMEOUT_SECONDS=180
# 整个 Design Jury run 的总超时时间，单位秒；超时后按 fallback 策略处理。
HARNESS_CRITIQUE_TOTAL_TIMEOUT_SECONDS=360
# Design Jury XML 协议块最大字节数，防止异常大输出拖垮解析。
HARNESS_CRITIQUE_PARSER_MAX_BLOCK_BYTES=262144
# 是否启用后台 recall sidecar 索引刷新 worker；只负责检索索引，不参与 prompt 主上下文拼接。
HARNESS_RECALL_SIDECAR_WORKER_ENABLED=true
# recall sidecar worker 空闲轮询间隔，单位秒。
HARNESS_RECALL_SIDECAR_WORKER_INTERVAL_SECONDS=5
# recall sidecar worker 数据库 claim 租约时长，单位秒。
HARNESS_RECALL_SIDECAR_WORKER_LEASE_SECONDS=60
# recall sidecar worker 单批处理数量。
HARNESS_RECALL_SIDECAR_WORKER_BATCH_SIZE=1
# 每个进程内 recall sidecar worker 并发数。
HARNESS_RECALL_SIDECAR_WORKER_MAX_CONCURRENCY=1
# 覆盖自动压缩触发百分比；留空表示使用代码默认值。
HARNESS_AUTOCOMPACT_PCT_OVERRIDE=
# 为 true 时禁用会话自动压缩；示例默认保持 Claude Code 风格 auto compact 开启。
HARNESS_DISABLE_AUTO_COMPACT=False
# 是否把每轮 Agent 模型请求的 prompt/cache 诊断写入会话 .meta/prompt_cache_debug；默认关闭。
HARNESS_PROMPT_CACHE_DEBUG=True
# 为 true 时在 prompt cache debug 文件中写入完整 system/messages/tools 内容；可能包含用户文件内容或 URL，仅排障时开启。
HARNESS_PROMPT_CACHE_DEBUG_FULL=True
# 媒体生成后，媒体敏感读工具触发 pending media 等待时回看最近多少次工具调用；0 表示关闭该隐式等待。
HARNESS_MEDIA_BARRIER_RECENT_TOOL_WINDOW=5

# =============================================================================
# 电商商品图生成提示词
# =============================================================================
# 商品图配置卡确认后追加给模型的上下文模板；分类/风格提示词来自参考图库 taxonomy.prompt。
ECOMMERCE_PRODUCT_IMAGE_CONTEXT_TEMPLATE="你需要参考上面实拍图图片分析内容，实拍图和对应的基准生成对应的图片\n\n{图片分类提示词}\n\n{图片风格提示词}\n\n{平台规则提示词}\n\n{人物参考图提示词}\n{人物参考图}\n\n{背景参考图提示词}\n{背景参考图}\n\n{其他商品主图参考图提示词}\n{其他商品参考图}\n\n{负面约束提示词}\n\n生成商品图数量：{生成商品图数量}\n\n{用户需求}"
# 国内男装电商平台主图通用规则。
ECOMMERCE_PRODUCT_IMAGE_PLATFORM_RULE_PROMPT="【平台规则】\n适合国内电商男装主图。主商品必须清楚完整，画面要有点击吸引力和转化价值。\n允许合理内搭、配件和道具强化穿搭联想，但不能误导买家以为内搭、配件或道具一定随商品售卖。主商品必须最大、最清楚、视觉权重最高。\n不添加文字、水印、边框、价格、促销角标、平台标签、销量、排名、最低价、官方认证、证书或虚假卖点。商品真实一致优先于风格氛围。"
# 背景参考图开关开启时加入。
ECOMMERCE_PRODUCT_IMAGE_BACKGROUND_REFERENCE_PROMPT="【背景参考图】\n仅参考背景图的场景结构、透视、光线、色调、景深、材质、道具位置与整体氛围，背景布局尽量高保真还原；不参考其中服装和人物，不新增文字、品牌、路人正脸或其他元素；背景真实、干净、高级，用于衬托主商品，主商品仍以商品锁定卡为准。"
# 人物参考图开关开启时加入。
ECOMMERCE_PRODUCT_IMAGE_MODEL_REFERENCE_PROMPT="【人物参考】\n仅参考模特的身材比例、镜头感和气质，不参考其服装与背景；用该模特自然穿搭主商品，搭配合理、比例协调，重点凸显主商品的版型、颜色、质感和细节，不遮挡关键卖点，画面真实高级、无AI感。"
# 其他商品主图参考图开关开启时加入。
ECOMMERCE_PRODUCT_IMAGE_OTHER_MAIN_IMAGE_REFERENCE_PROMPT="【其他主图参考提示词】\n仅参考参考图的主图风格、构图、背景、人物姿态、镜头角度、光影与氛围，不参考其服装商品本身；若含人物，仅学习身材比例、动作和气质，不复制脸部、服装和品牌元素；用主商品生成相似风格的电商主图，主商品真实一致、清晰突出、自然高级、无AI感。"
# 商品图通用负面约束和最终输出规则。
ECOMMERCE_PRODUCT_IMAGE_NEGATIVE_PROMPT="【通用负面约束】\n不要失真、不要变形、不要拉伸、不要比例错误、不要透视错误、不要结构错位、不要左右翻转错误、不要穿模、不要面料和纹理失真、不要颜色偏移、不要版型改变、不要领型/袖型/门襟/口袋/纽扣/拉链/拼接/下摆/标签/织标错误、不要凭空新增或删除真实细节。\n\n不要搭配混乱、不要颜色冲突、不要风格冲突、不要道具堆砌、不要配饰抢主体、不要内搭外搭关系错误、不要背景喧宾夺主、不要让人物或道具盖住商品关键卖点。\n\n不要主次混乱、不要主体太小、不要裁切关键部位、不要多主体并列、不要九宫格、不要拼图、不要海报化过强。\n\n不要直接复制参考图中的服装、人物、背景、道具、文字、品牌元素和构图细节，不要让参考图替代主商品，只能参考其风格、氛围、光影和布局逻辑。\n\n不要低清、模糊、噪点、过曝、死黑、重滤镜、AI感、塑料感、过度磨皮、毛边、抠图溢色、文字乱码、水印、边框、价格牌、促销字、二维码、虚假品牌标识、侵权元素、路人正脸、可识别身份。\n\n【最终输出】\n输出 4-6 张独立的高级男装【分类+风格】主图候选。\n每张图都必须展示同一件主商品，但通过不同内搭、配件、道具、背景氛围和摆放方式呈现不同转化角度。\n主商品必须真实一致、完整清楚、细节可信。\n允许基础内搭、自然打开门襟、合理褶皱和年轻化边缘道具来提升点击和转化，但不得改变、遮挡或替换主商品。\n不要拼图，不要九宫格，不要编号，不要在图片上添加文字。"

# =============================================================================
# Web 搜索
# =============================================================================
# agent Web 搜索工具使用的搜索提供商。
SEARCH_PROVIDER=duckduckgo
# 搜索请求超时时间，单位秒；DuckDuckGo 偶发慢，15s 比较稳定。
SEARCH_TIMEOUT_SECONDS=15
# 单次搜索请求最多返回的结果数。
SEARCH_MAX_RESULTS=10
# DuckDuckGo 区域代码，用于影响语言和地区偏好。
DUCKDUCKGO_REGION=cn-zh
# DuckDuckGo 安全搜索级别，常见值：off、moderate、strict。
DUCKDUCKGO_SAFESEARCH=moderate
# DuckDuckGo 时间范围过滤；留空表示不限制。
DUCKDUCKGO_TIME_LIMIT=
# DuckDuckGo 后端模式。
DUCKDUCKGO_BACKEND=auto

# =============================================================================
# Provider 余额、限流与 APIMart
# =============================================================================
# LingyaAI 网关地址。根据 key 所属环境选择，例如 https://lyapi.com 或 https://api.lingyaai.cn。
LINGYAAI_BASE_URL=https://lyapi.com
# 是否启用 provider 余额同步模式；私有化部署可按上游余额控制请求放行。
PROVIDER_BALANCE_SYNC_ENABLED=true
# 余额同步 worker 执行间隔，单位秒。
PROVIDER_BALANCE_SYNC_INTERVAL_SECONDS=300
# generation submit 分布式限流：窗口内最大请求数。
PROVIDER_RATE_LIMIT_GENERATION_SUBMIT_LIMIT=120
# generation submit 分布式限流窗口，单位秒。
PROVIDER_RATE_LIMIT_GENERATION_SUBMIT_WINDOW_SECONDS=60
# generation query 分布式限流：窗口内最大请求数。
PROVIDER_RATE_LIMIT_GENERATION_QUERY_LIMIT=600
# generation query 分布式限流窗口，单位秒。
PROVIDER_RATE_LIMIT_GENERATION_QUERY_WINDOW_SECONDS=60
# result download 分布式限流：窗口内最大请求数。
PROVIDER_RATE_LIMIT_RESULT_DOWNLOAD_LIMIT=300
# result download 分布式限流窗口，单位秒。
PROVIDER_RATE_LIMIT_RESULT_DOWNLOAD_WINDOW_SECONDS=60
# balance fetch 分布式限流：窗口内最大请求数。
PROVIDER_RATE_LIMIT_BALANCE_FETCH_LIMIT=1
# balance fetch 分布式限流窗口，单位秒。
PROVIDER_RATE_LIMIT_BALANCE_FETCH_WINDOW_SECONDS=300
# billing fetch 分布式限流：窗口内最大请求数。
PROVIDER_RATE_LIMIT_BILLING_FETCH_LIMIT=9
# billing fetch 分布式限流窗口，单位秒。
PROVIDER_RATE_LIMIT_BILLING_FETCH_WINDOW_SECONDS=60
# APIMart 请求总超时时间，单位秒。
APIMART_TIMEOUT_SECONDS=300

# =============================================================================
# LingyaAI 计费对账
# =============================================================================
# 计费对账 worker 执行间隔，单位秒。
LINGYAAI_BILLING_RECONCILE_INTERVAL_SECONDS=5
# 单批计费对账数量。
LINGYAAI_BILLING_RECONCILE_BATCH_SIZE=50
# 计费对账分布式锁有效期，单位秒。
LINGYAAI_BILLING_RECONCILE_LOCK_SECONDS=30
# 任务创建后快速重试阶段的截止时间，单位秒。
LINGYAAI_BILLING_FAST_RETRY_SECONDS=60
# 快速计费检查的重试延迟，单位秒。
LINGYAAI_BILLING_FAST_RETRY_DELAY_SECONDS=1
# 常规计费检查的重试延迟，单位秒。
LINGYAAI_BILLING_NORMAL_RETRY_DELAY_SECONDS=5
# 慢速计费检查的重试延迟，单位秒。
LINGYAAI_BILLING_SLOW_RETRY_DELAY_SECONDS=30
# 未解决计费记录超过该时长后进入人工复核，单位秒。
LINGYAAI_BILLING_MANUAL_REVIEW_AFTER_SECONDS=900

# =============================================================================
# Ollama 兼容本地多模态模型
# =============================================================================
# 是否启用本地 Ollama 兼容多模态模型调用。
OLLAMA_MULTIMODAL_ENABLED=true
# 是否通过 Ollama 兼容模型启用图片分析。
OLLAMA_IMAGE_ANALYSIS_ENABLED=true
# Ollama 兼容 OpenAI API 的基础地址。
OLLAMA_BASE_URL=https://api.lmuai.com/v1
OLLAMA_IMAGE_API_KEY=
# 发送到 Ollama 兼容接口的 API Key；很多本地接口可接受任意占位值。
OLLAMA_API_KEY=
# 发送到 Ollama 兼容接口的多模态模型名称。
OLLAMA_MULTIMODAL_MODEL=gpt-5.5
# 发送到 Ollama 兼容接口的最大输入 token 数；0 表示使用提供方默认值。
OLLAMA_MAX_INPUT_TOKENS=1000000
# 向 Ollama 兼容接口请求的最大输出 token 数；0 表示使用提供方默认值。
OLLAMA_MAX_OUTPUT_TOKENS=96000
# tool_choice 发送格式：openai 使用 OpenAI Chat Completions 标准嵌套格式；flat 用于只接受 Responses 风格顶层 name 的旧转发器。
OLLAMA_TOOL_CHOICE_FORMAT=flat
# 是否通过 Ollama 兼容接口启用图片生成。
OLLAMA_IMAGE_GENERATION_ENABLED=false
# 图片生成模型名称；留空则复用 OLLAMA_MULTIMODAL_MODEL。
OLLAMA_IMAGE_GENERATION_MODEL=gpt-image-2
# 图片生成能力配置，多个配置项用英文分号分隔。
# 当前推荐本地图片模型为 gpt-image-2：1K/2K/4K 档位、15 个比例、支持最多 16 张参考图。
# 其中 4K 是模型清晰度档位，不等于固定 4096 方图；前端会按模型规格解析显示尺寸。
OLLAMA_IMAGE_GENERATION_CONFIG=sizes=1K|2K|4K;ratios=1:1|16:9|9:16|2:1|1:2|4:3|3:4|3:2|2:3|5:4|4:5|21:9|9:21|3:1|1:3;reference=true;max_refs=16;response_format=url;reference_mode=edits

# =============================================================================
# Agent worker 资源规格
# 这些值应按机器 CPU/内存/显存和外部 LLM 限流调整；worker lease/poll 等协议参数在代码中固定。
# =============================================================================
# 同一 agent-worker 进程最多同时执行的 agent run 数量。
HARNESS_AGENT_MAX_ACTIVE_RUNS=8
# 同一 agent-worker 进程最多同时 claim 并调度的 workflow step 数量。
HARNESS_WORKFLOW_MAX_ACTIVE_STEPS=8
# workflow activity 隔离线程数量；用于承载模型、工具、文件和历史 async activity，避免阻塞 scheduler loop。
HARNESS_BLOCKING_IO_WORKERS=6
# 单个模型轮次内安全工具 segment 的最大并发数；仍受各资源类型并发限制约束。
HARNESS_TOOL_BATCH_MAX_CONCURRENCY=10
# presentation delta 是否先走 live 通道并异步批量持久化；保留为生产回滚开关。
HARNESS_PRESENTATION_DELTA_ASYNC_PERSIST_ENABLED=true
# agent-context 并发；不占 active run slot。
HARNESS_AGENT_CONTEXT_CONCURRENCY=1
# LLM/API 调用并发，主要受外部 provider 限流和网络影响。
HARNESS_RESOURCE_LLM_CONCURRENCY=16
# 文件 I/O offload 并发。
HARNESS_RESOURCE_FILE_IO_CONCURRENCY=10
# CPU 工具并发。
HARNESS_RESOURCE_CPU_TOOL_CONCURRENCY=4
# 子进程工具并发。
HARNESS_RESOURCE_SUBPROCESS_CONCURRENCY=8
# 浏览器任务并发。
HARNESS_RESOURCE_BROWSER_CONCURRENCY=2
# Office 文档任务并发。
HARNESS_RESOURCE_OFFICE_CONCURRENCY=1
# 网络工具并发。
HARNESS_RESOURCE_NETWORK_CONCURRENCY=16

# =============================================================================
# Agent workflow 诊断日志（默认关闭）
# 开启后只输出耗时、step/activity/lease 元数据；不要记录 prompt、用户文件内容或密钥。
# =============================================================================
# 是否启用 workflow step 慢日志、retry、terminalize、lease safety 和细分阶段耗时日志。
HARNESS_WORKFLOW_DIAGNOSTICS_ENABLED=True
# 是否启用 activity 慢日志。
HARNESS_ACTIVITY_DIAGNOSTICS_ENABLED=True
# 是否启用 asyncio slow callback 和 event loop lag 诊断。
HARNESS_ASYNCIO_DIAGNOSTICS_ENABLED=True
# asyncio slow callback 警告阈值，单位秒。
HARNESS_ASYNCIO_SLOW_CALLBACK_SECONDS=5.0
# asyncio event loop lag 告警阈值，单位秒。
HARNESS_ASYNCIO_LAG_THRESHOLD_SECONDS=5.0
# asyncio event loop lag 探测间隔，单位秒。
HARNESS_ASYNCIO_LAG_INTERVAL_SECONDS=0.5
# 是否启用 workflow 工具失败循环诊断。
HARNESS_TOOL_LOOP_DIAGNOSTICS_ENABLED=True
# 同一控制工具连续参数/校验失败多少次后熔断 run。
HARNESS_WORKFLOW_TOOL_FAILURE_BREAKER_THRESHOLD=3
# legacy fallback 慢日志阈值，单位秒；未设置专用阈值时使用。
HARNESS_PERF_SEGMENT_WARNING_SECONDS=1
# workflow step 慢日志警告阈值，单位秒；避免正常模型/工具 step 产生 warning 噪声。
HARNESS_WORKFLOW_STEP_WARNING_SECONDS=10.0
# activity 慢日志警告阈值，单位秒。
HARNESS_ACTIVITY_WARNING_SECONDS=10.0
# step lease 安全余量告警阈值，单位秒。
HARNESS_LEASE_SAFETY_WARNING_SECONDS=30

